ANTHROPIC_API_KEY=your_key_here
# Optional: override which Anthropic model to use if your account does not support the default selection.
# Example: ANTHROPIC_MODEL=fable-5
# Supported example models (both short and fully-qualified Claude IDs):
# Short names: fable-5, opus-4.8, sonnet-4.6, haiku-4.5
# Claude-style fully-qualified: claude-fable-5, claude-opus-4-8, claude-sonnet-4-6, claude-haiku-4-5
# You can also provide a comma-separated list: ANTHROPIC_MODEL=claude-fable-5,sonnet-4.6
ANTHROPIC_MODEL=fable-5
